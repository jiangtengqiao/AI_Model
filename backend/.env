APP_NAME=贤智AI
DEBUG=True

# 数据库配置 - 使用 SQLite 以便快速演示
DATABASE_URL=sqlite:///./data/xianzhi.db
# 如果有 PostgreSQL，使用：
# DATABASE_URL=postgresql://xianzhi:password@localhost:5432/xianzhi_ai

# Redis 配置 - 可选，没有 Redis 可以留空
REDIS_URL=

# JWT密钥 - 请修改为您自己的密钥
SECRET_KEY=change-this-secret-key-to-something-secure-in-production-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI API配置 - 必须配置才能使用AI功能
OPENAI_API_KEY=sk-your-actual-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-3.5-turbo

CHROMA_PERSIST_DIR=./data/chroma
